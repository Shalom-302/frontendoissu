# Normalise line endings in the repository: LF in git, native in the working
# copy. Without this, a Windows checkout would CRLF the shell scripts and the
# Dockerfile heredocs that run inside Linux containers.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
