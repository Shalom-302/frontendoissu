# OISSU CONNECT — client (branche dev)
# Copiez ce fichier en `.env`. Les tests locaux et le CORS local se règlent ici.

NODE_ENV=development

# Adresse de l'API vue par le SERVEUR Next.js. C'est la seule indispensable :
# le navigateur ne parle qu'à Next.js (via /api/proxy), jamais à l'API.
#   npm run dev sur l'hôte          -> http://localhost:8000
#   docker compose up (dev)         -> http://host.docker.internal:8000
API_INTERNAL_URL=http://localhost:8000

# Repli documentaire : conservez-le aligné sur l'URL publique de l'API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Port publié sur l'hôte.
WEB_PORT=3000

# --- CORS local ---
# Le front étant en same-origin, aucun pre-flight n'est nécessaire. Si vous
# appelez l'API directement (Swagger, curl, outil tiers), déclarez l'origine
# côté backend, dans son .env :
#   CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
#   COOKIE_SAMESITE=lax
#   COOKIE_SECURE=false
