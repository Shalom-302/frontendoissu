# OISSU CONNECT — client (branche main / production)
# Copiez ce fichier en `.env` sur l'hôte de production. N'y mettez jamais de
# secret : ce front n'en détient aucun, il n'expose que des adresses.

NODE_ENV=production

# Adresse de l'API vue par le SERVEUR Next.js. Obligatoire : le compose refuse
# de démarrer sans elle.
#   même hôte Docker  -> http://oissu_api:8000  (réseau partagé avec le backend)
#   API distante      -> https://api.oissu-connect.example
API_INTERNAL_URL=https://api.oissu-connect.example

# URL publique de l'API (repli documentaire).
NEXT_PUBLIC_API_URL=https://api.oissu-connect.example

# Port publié sur l'hôte, derrière le reverse proxy.
WEB_PORT=3000

# --- Côté backend (.env de l'API) ---
#   ENVIRONMENT=prod
#   CORS_ALLOWED_ORIGINS=["https://oissu-connect.example"]
#   COOKIE_SAMESITE=none
#   COOKIE_SECURE=true
#
# Et surtout : le seed de démonstration ne doit JAMAIS être exécuté ici
# (conception §17, §18).
