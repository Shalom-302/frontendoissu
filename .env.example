# OISSU CONNECT — client (branche staging)
# Copiez ce fichier en `.env` sur l'hôte de pré-production.

NODE_ENV=production

# Adresse de l'API vue par le SERVEUR Next.js. Obligatoire en staging : le
# compose refuse de démarrer sans elle, pour qu'un déploiement ne retombe jamais
# silencieusement sur une API locale.
#
# Le conteneur est attaché à `dokploy-network` (réseau externe créé par Dokploy
# sur le VPS). Si l'API tourne sur ce même réseau, elle se joint par son nom de
# service — aucun port à publier :
#   API_INTERNAL_URL=http://oissu_api:8000
# Sinon, l'URL publique de l'API :
#   API_INTERNAL_URL=https://api-staging.oissu-connect.example
API_INTERNAL_URL=http://oissu_api:8000

# URL publique de l'API (repli documentaire).
NEXT_PUBLIC_API_URL=https://api-staging.oissu-connect.example

# Port publié sur l'hôte — distinct du dev pour cohabiter sur une même machine.
WEB_PORT=3001

# --- Côté backend (.env de l'API) ---
# Le front est same-origin, mais le cookie de refresh traverse le domaine si
# l'API est sur un autre hôte :
#   CORS_ALLOWED_ORIGINS=["https://staging.oissu-connect.example"]
#   COOKIE_SAMESITE=none
#   COOKIE_SECURE=true
