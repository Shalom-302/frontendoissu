# OISSU CONNECT — client (branche staging)
# Copiez ce fichier en `.env` sur l'hôte de pré-production.

NODE_ENV=production

# Adresse de l'API vue par le SERVEUR Next.js.
#
# Le conteneur est attaché à `dokploy-network` (réseau externe de Dokploy), le
# même que la stack de l'API : elle se joint donc par son nom de conteneur, sans
# sortir sur Internet. C'est la valeur par défaut du compose, vous n'avez rien à
# définir si les deux stacks sont sur le même hôte.
#   API_INTERNAL_URL=http://oissu_api:8000
#
# Si l'API est ailleurs, mettez son URL publique :
#   API_INTERNAL_URL=https://oissu-api.kortex.sbs
API_INTERNAL_URL=http://oissu_api:8000

# URL publique de l'API (repli documentaire).
NEXT_PUBLIC_API_URL=https://oissu-api.kortex.sbs

# Port publié sur l'hôte — distinct du dev pour cohabiter sur une même machine.
WEB_PORT=3001

# --- Côté backend (.env de l'API) ---
# Le front est same-origin, mais le cookie de refresh traverse le domaine si
# l'API est sur un autre hôte :
#   CORS_ALLOWED_ORIGINS=["https://VOTRE-DOMAINE-FRONT"]
#   COOKIE_SAMESITE=none
#   COOKIE_SECURE=true
